# Core app
ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# PostHog (module defaults)
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_API_HOST=https://eu.i.posthog.com

# PostHog (explicit nuxt.config.ts mapping)
NUXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Twitch (application Clippeak, une seule pour tous les streamers)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaine aleatoire de 10 a 100 caracteres, inventee par nous, sert a signer les notifications
TWITCH_EVENTSUB_SECRET=
# URL publique HTTPS (port 443) de la route de reception, ex : https://TON-DOMAINE/api/twitch/eventsub
TWITCH_EVENTSUB_CALLBACK_URL=

# -- Transcription locale (Whisper)
# WHISPER_PYTHON=/srv/saas/clippeak/.venv/bin/python
# WHISPER_MODEL=small
# WHISPER_SCRIPT=scripts/whisper/transcribe.py
# WHISPER_THREADS=2
