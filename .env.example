# Core app
ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# PostHog (module defaults)
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_API_HOST=https://eu.i.posthog.com

# PostHog (explicit nuxt.config.ts mapping). Lues au BUILD : sur le VPS, les mettre dans /srv/saas/clippeak/.env (pas .env.local, non lu au build).
NUXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Twitch (application Clippeak, une seule pour tous les streamers)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaine aleatoire de 10 a 100 caracteres, inventee par nous, sert a signer les notifications
TWITCH_EVENTSUB_SECRET=
# URL publique HTTPS (port 443) de la route de reception, ex : https://TON-DOMAINE/api/twitch/eventsub
TWITCH_EVENTSUB_CALLBACK_URL=
# Connexion « Se connecter avec Twitch » : cette adresse doit etre declaree dans les URL de redirection OAuth de l'application Twitch.
# Facultatif : par defaut CLIPPEAK_PUBLIC_URL + /api/auth/twitch/callback (ou l'hote de la requete)
# TWITCH_LOGIN_REDIRECT_URL=https://TON-DOMAINE/api/auth/twitch/callback

# -- Transcription locale (Whisper)
# WHISPER_PYTHON=/srv/saas/clippeak/.venv/bin/python
# WHISPER_MODEL=small
# WHISPER_SCRIPT=scripts/whisper/transcribe.py
# WHISPER_THREADS=2
# CLIPPEAK_DATA_DIR=/srv/saas/clippeak-data
# RENDER_THREADS=2
# WORKER_POLL_SEC=20
# ANTHROPIC_API_KEY=
# CLIPPEAK_LLM_MODEL=claude-sonnet-5-5
# VISION_PYTHON=
# VISION_MODELS_DIR=
# WORKER_SIMILARITY_SCAN=1
# YTDLP_BIN=/srv/saas/clippeak/.venv/bin/yt-dlp
# WORKER_LIVE_INTERVAL_SEC=300
# WORKER_LIVE_ANALYSIS=1
# CLIPPEAK_PUBLIC_URL=https://clippeak.sassify.fr
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -- Publication YouTube (programmation + publication des clips approuves)
# Cle de chiffrement des jetons de plateformes : 32 octets en base64. Generer UNE fois : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A mettre sur le serveur ET dans /etc/clippeak/worker.env. La perdre = reconnecter tous les comptes. Ne jamais la committer.
CLIPPEAK_TOKEN_KEY=
# Application OAuth Google Cloud (YouTube Data API v3). Redirection a declarer : https://TON-DOMAINE/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -- Publication TikTok (portail TikTok for Developers > ton application ; poser avec `bash scripts/ops/run-on-vps.sh tiktok`)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Adresse de retour declaree chez TikTok (defaut : <adresse publique>/api/auth/tiktok/callback)
# TIKTOK_REDIRECT_URL=

# -- Publication Instagram (Reels) : voir PROCEDURE-INSTAGRAM.md
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_CONFIG_ID=
# Adresse de retour declaree chez Meta (defaut : <adresse publique>/api/auth/instagram/callback)
# INSTAGRAM_REDIRECT_URL=

# -- Facturation Stripe (cles de production : voir CHECKLIST-OUVERTURE.md)
# Cle secrete ou cle restreinte (rk_) ; `sk_test_` / `rk_test_` = mode test. STRIPE_SECRET_API_KEY est accepte aussi (ancien nom).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Prix de l'offre Creator (mensuel obligatoire ; l'annuel est facultatif : sans lui, seul le mensuel est propose)
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_CREATOR_YEARLY=
# Pied de facture : texte libre (par defaut la mention de franchise en base de TVA) ; `none` pour ne rien imprimer
# STRIPE_INVOICE_FOOTER=

# -- Detection par le contenu du live (transcription externe Groq, ou Whisper local en secours)
# GROQ_API_KEY=
# 1 = si Groq echoue (ou sans cle), le serveur transcrit lui-meme avec Whisper local (lent : 2 coeurs). Defaut : 0.
# WORKER_LOCAL_FALLBACK=0

# -- Interrupteurs du worker (actifs par defaut ; mettre 0 pour couper)
# WORKER_CONTENT_DETECTION=0
# WORKER_LONG_ANALYSIS=0
# WORKER_LONG_MARKERS=0
# WORKER_SIMILARITY_SCAN=0

# -- Telemetrie Sassify Ops (cout des appels Anthropic, notification de deploiement) : facultatif
# OPS_URL=
# OPS_INGEST_KEY=

# -- Divers
# Code d'entree de la chaine « Relecture Meta » (sans lui, la route /api/auth/relecteur n'existe pas)
# REVIEWER_CODE=
# Polices des titres de clips (defaut : public/fonts)
# CLIPPEAK_FONTS_DIR=
# Rattrapage periodique des VODs manquees : actif en production ; en local, TWITCH_CATCHUP=1 pour l'activer
# TWITCH_CATCHUP=1
# Intervalle en secondes (minimum 60 ; defaut dans server/plugins/vodCatchup.ts)
# TWITCH_CATCHUP_INTERVAL_SEC=
# Adresses de substitution pour les tests d'integration (faux Twitch, faux Stripe...) : *_API_BASE_URL, TWITCH_GQL_URL, TWITCH_USHER_URL,
# GOOGLE_TOKEN_URL, CLIPPEAK_RECHECK_COOLDOWN_MS. Jamais en production.
