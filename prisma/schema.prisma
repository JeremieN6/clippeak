generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AutomationChoice {
  oui
  non
  peut_etre
}

model Feedback {
  id                  String           @id @default(uuid()) @db.Uuid
  version             String           @default("v1") @db.VarChar(20)
  outilAutomatise     AutomationChoice @map("outil_automatise")
  plateformeReception String           @map("plateforme_reception") @db.VarChar(40)
  plateformeAutre     String?          @map("plateforme_autre") @db.VarChar(120)
  vodsParMois         String           @map("vods_par_mois") @db.VarChar(20)
  profil              String           @db.VarChar(40)
  manque              String?
  email               String?          @db.VarChar(255)
  createdAt           DateTime         @default(now()) @map("created_at")

  @@map("feedbacks")
}

enum VodStatus {
  live
  ended
  analyzing
  done
  failed
}

enum VodSource {
  auto
  manual
}

enum MomentStatus {
  candidate
  validated
  rejected
}

enum ClipJobStatus {
  queued
  rendering
  review
  approved
  rejected
  failed
}

model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  twitchId    String   @unique @map("twitch_id") @db.VarChar(40)
  login       String   @db.VarChar(60)
  displayName String   @map("display_name") @db.VarChar(80)
  autoClip    Boolean  @default(true) @map("auto_clip")
  createdAt   DateTime @default(now()) @map("created_at")

  settings       StreamerSettings?
  style          StreamerStyle?
  vods           Vod[]
  referenceClips ReferenceClip[]
  referenceItems ReferenceItem[]
  assets         StreamerAsset[]
  sessions       StudioSession[]

  @@map("channels")
}

model StreamerSettings {
  id             String   @id @default(uuid()) @db.Uuid
  channelId      String   @unique @map("channel_id") @db.Uuid
  keywords       String[] @default(["mdr", "ptdr", "lol", "omg", "xd", "kekw"])
  clipMinSec     Int      @default(30) @map("clip_min_sec")
  clipMaxSec     Int      @default(60) @map("clip_max_sec")
  subtitles      Boolean  @default(true)
  accentColor    String   @default("#FFFFFF") @map("accent_color") @db.VarChar(9)
  highlightColor String   @default("#FFD400") @map("highlight_color") @db.VarChar(9)
  updatedAt      DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("streamer_settings")
}

model Vod {
  id          String    @id @default(uuid()) @db.Uuid
  channelId   String    @map("channel_id") @db.Uuid
  twitchVodId String    @unique @map("twitch_vod_id") @db.VarChar(40)
  url         String    @db.VarChar(255)
  title       String?   @db.VarChar(255)
  status      VodStatus @default(live)
  source      VodSource @default(auto)
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  // Avancement du balayage par ressemblance (secondes de VOD deja transcrites et comparees aux clips de reference).
  scanSec     Float?    @map("scan_sec")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  moments Moment[]

  @@index([channelId])
  @@map("vods")
}

model Moment {
  id        String       @id @default(uuid()) @db.Uuid
  vodId     String       @map("vod_id") @db.Uuid
  startSec  Float        @map("start_sec")
  endSec    Float        @map("end_sec")
  peakSec   Float        @map("peak_sec")
  score     Float
  signals   Json
  status    MomentStatus @default(candidate)
  createdAt DateTime     @default(now()) @map("created_at")

  // Analyse (transcription autour du pic, note finale sur 10, accroche) - colonnes ajoutees par 202610241000_v2_clip_pipeline.
  transcript Json?
  beforePeak String?  @map("before_peak")
  hook       String?
  category   String?  @db.VarChar(60)
  kind       String?  @db.VarChar(20)
  aiScore    Float?   @map("ai_score")
  rationale  String?
  scorer     String?  @db.VarChar(20)

  vod  Vod       @relation(fields: [vodId], references: [id], onDelete: Cascade)
  jobs ClipJob[]

  @@index([vodId])
  @@map("moments")
}

model ClipJob {
  id         String        @id @default(uuid()) @db.Uuid
  momentId   String        @map("moment_id") @db.Uuid
  status     ClipJobStatus @default(queued)
  batch      Int?
  title      String?       @db.VarChar(255)
  caption    String?
  outputPath String?       @map("output_path") @db.VarChar(500)
  error      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  // Plan de coupe, controle qualite et validation humaine.
  startSec      Float?    @map("start_sec")
  endSec        Float?    @map("end_sec")
  keepRanges    Json?     @map("keep_ranges")
  hashtags      String?
  qc            Json?
  illustrations Json?
  reviewNote    String?   @map("review_note")
  reviewedAt    DateTime? @map("reviewed_at")
  notifiedAt    DateTime? @map("notified_at")

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("clip_jobs")
}

// Direction artistique du streamer (titre, sous-titres, zoom, SFX, cadrage, avatar) : un JSON valide par zod cote serveur.
model StreamerStyle {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @unique @map("channel_id") @db.Uuid
  config    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("streamer_styles")
}

// Fichiers du streamer : photos de reconnaissance, avatar/GIF, SFX, polices, videos d'illustration (avec leur source).
model StreamerAsset {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  kind      String   @db.VarChar(20)
  filename  String   @db.VarChar(200)
  path      String   @db.VarChar(500)
  tags      String[] @default([])
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, kind])
  @@map("streamer_assets")
}

// Banque de clips de reference (API Twitch Clips) : vues, categorie, sujets.
model ReferenceClip {
  id           String   @id @default(uuid()) @db.Uuid
  channelId    String   @map("channel_id") @db.Uuid
  twitchClipId String   @unique @map("twitch_clip_id") @db.VarChar(100)
  title        String   @db.VarChar(255)
  viewCount    Int      @map("view_count")
  durationSec  Float    @map("duration_sec")
  category     String   @db.VarChar(100)
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("reference_clips")
}

// Clips de reference analyses par l'IA : videos deposees ou liens (YouTube Shorts, TikTok, Instagram). Transcription (Whisper)
// et analyse (images cles + texte) servent de base a la detection de moments ressemblants dans les lives et les VODs.
// Les statistiques sont facultatives (null = inconnues).
model ReferenceItem {
  id           String    @id @default(uuid()) @db.Uuid
  channelId    String    @map("channel_id") @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  // clip | account (un compte est developpe en plusieurs clips)
  kind         String    @default("clip") @db.VarChar(10)
  // upload | youtube | tiktok | instagram
  source       String    @db.VarChar(12)
  url          String?   @db.VarChar(500)
  filePath     String?   @map("file_path") @db.VarChar(500)
  title        String?   @db.VarChar(255)
  durationSec  Float?    @map("duration_sec")
  viewCount    Float?    @map("view_count")
  likeCount    Float?    @map("like_count")
  commentCount Float?    @map("comment_count")
  shareCount   Float?    @map("share_count")
  // pending | processing | done | failed
  status       String    @default("pending") @db.VarChar(12)
  note         String?
  error        String?
  transcript   Json?
  analysis     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  analyzedAt   DateTime? @map("analyzed_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, url])
  @@index([channelId, status])
  @@map("reference_items")
}

// Chaines autorisees a se connecter avec Twitch (inscription sur invitation : l'admin ajoute le pseudo, jamais le streamer lui-meme).
model ChannelInvite {
  id          String    @id @default(uuid()) @db.Uuid
  twitchLogin String    @unique @map("twitch_login") @db.VarChar(25)
  twitchId    String?   @unique @map("twitch_id") @db.VarChar(40)
  note        String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("channel_invites")
}

// Session d'un streamer connecte : seul le hash SHA-256 du jeton est conserve (le jeton ne vit que dans le cookie).
model StudioSession {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("studio_sessions")
}
